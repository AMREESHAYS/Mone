<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for Android 12+. The Instagram session (cookies.txt + the
   WebView cookie store) must never leave the device: not to the cloud, not to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cookies.txt" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
