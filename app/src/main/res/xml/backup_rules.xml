<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and below (API 31+ uses data_extraction_rules.xml).
   The Instagram session (cookies.txt + the WebView cookie store) must never leave the device.
-->
<full-backup-content>
    <exclude domain="file" path="cookies.txt" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
